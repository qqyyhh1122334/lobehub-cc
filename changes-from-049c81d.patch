@@ -0,0 +1,45 @@
+import { createHash } from 'node:crypto';
+import { execFileSync } from 'node:child_process';
+import { createReadStream, existsSync, mkdirSync, writeFileSync } from 'node:fs';
+import { dirname, join, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const dir = dirname(fileURLToPath(import.meta.url));
+const destination = resolve(process.argv[2] || join(dir, 'bundle'));
+mkdirSync(destination, { recursive: true });
+if (existsSync(join(destination, 'images.tar')))
+  throw new Error('Destination images.tar already exists');
+const docker = (...args) =>
+  execFileSync('docker', args, {
+    cwd: dir,
+    encoding: 'utf8',
+    stdio: ['ignore', 'pipe', 'inherit'],
+    maxBuffer: 32 * 1024 * 1024,
+  });
+// Never pull here. Image acquisition/build is a separate, explicit connected step.
+const images = [
+  ...new Set(docker('compose', '-f', 'compose.yaml', 'config', '--images').trim().split('\n')),
+];
+const manifest = {
+  schema: 1,
+  baseCommit: '049c81d53b0c2282eabf1edca2d90d58ad1f60f0',
+  exportedAt: new Date().toISOString(),
+  images: images.map((tag) => {
+    const [info] = JSON.parse(docker('image', 'inspect', tag));
+    return {
+      tag,
+      id: info.Id,
+      architecture: info.Architecture,
+      os: info.Os,
+      repoDigests: info.RepoDigests || [],
+    };
+  }),
+};
+docker('image', 'save', '--output', join(destination, 'images.tar'), ...images);
+const hash = createHash('sha256');
+for await (const chunk of createReadStream(join(destination, 'images.tar'))) hash.update(chunk);
+manifest.archiveSha256 = hash.digest('hex');
+writeFileSync(join(destination, 'manifest.json'), JSON.stringify(manifest, null, 2) + '\n');
+console.log(
+  `Exported ${images.length} local images to ${destination}; no credentials or models are in this bundle.`,
+);
diff --git a/deploy/intranet/firewall.sh b/deploy/intranet/firewall.sh
new file mode 100644
index 0000000000..5fc3420daa
--- /dev/null
+++ b/deploy/intranet/firewall.sh
@@ -0,0 +1,32 @@
+#!/bin/sh
+set -eu
+# Executed once before the application is permitted to start. Docker's NAT
+# table is untouched; deny rules are installed before allowing any traffic.
+iptables -P INPUT DROP
+iptables -P FORWARD DROP
+iptables -P OUTPUT DROP
+iptables -F INPUT
+iptables -F FORWARD
+iptables -F OUTPUT
+iptables -A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
+iptables -A OUTPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
+iptables -A INPUT -i lo -p tcp -m multiport --dports 3210,8443 -j ACCEPT
+iptables -A OUTPUT -o lo -d 127.0.0.1 -p tcp -m multiport --dports 3210,8443 -j ACCEPT
+iptables -A INPUT -p tcp --dport 8443 -j ACCEPT
+for endpoint in '172.30.90.10 5432' '172.30.90.11 6379' '172.30.90.12 9000' '172.30.90.13 11434'; do
+    set -- $endpoint
+    iptables -A OUTPUT -d "$1" -p tcp --dport "$2" -j ACCEPT
+done
+# Direct DNS goes only to our non-forwarding authority. Docker's 127.0.0.11
+# resolver, host gateway DNS and public DoH/DoT are deliberately not allowed.
+iptables -A OUTPUT -d 172.30.90.53 -p udp --dport 53 -j ACCEPT
+iptables -A OUTPUT -d 172.30.90.53 -p tcp --dport 53 -j ACCEPT
+iptables -A OUTPUT -j REJECT --reject-with icmp-port-unreachable
+ip6tables -P INPUT DROP
+ip6tables -P FORWARD DROP
+ip6tables -P OUTPUT DROP
+ip6tables -F INPUT
+ip6tables -F FORWARD
+ip6tables -F OUTPUT
+touch /run/policy-ready
+exec tail -f /dev/null
