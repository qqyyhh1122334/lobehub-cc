diff --git a/scripts/intranet/build.cjs b/scripts/intranet/build.cjs
new file mode 100644
index 0000000000..5b1e5b8f8b
--- /dev/null
+++ b/scripts/intranet/build.cjs
@@ -0,0 +1,158 @@
+'use strict';
+
+const { spawn } = require('node:child_process');
+const { existsSync, readdirSync, rmSync } = require('node:fs');
+const path = require('node:path');
+
+const repositoryRoot = path.resolve(__dirname, '../..');
+const guard = path.join(__dirname, 'network-guard.cjs');
+const modes = new Set(['all', 'desktop', 'mobile', 'copy', 'next', 'analyze']);
+
+function createBuildEnv(input = process.env, extra = {}) {
+  const value = input.LOBE_BUILD_HEAP_MB || '4400';
+  if (!/^\d+$/.test(value) || Number(value) < 1024 || Number(value) > 8192)
+    throw new Error('LOBE_BUILD_HEAP_MB must be an integer from 1024 through 8192');
+  return {
+    ...input,
+    ...extra,
+    // All Node build workers inherit the policy, including Next instrumentation.
+    // No application runtime endpoint or user NODE_OPTIONS override is accepted.
+    NODE_OPTIONS: `--max-old-space-size=${value} --require=${JSON.stringify(guard)}`,
+    LOBE_INTRANET_ALLOWED_ENDPOINTS: '',
+    NODE_ENV: 'production',
+    NEXT_TELEMETRY_DISABLED: '1',
+    DOCKER: 'true',
+    MOBILE: extra.MOBILE || 'false',
+    RAYON_NUM_THREADS: '2',
+    UV_THREADPOOL_SIZE: '2',
+    HTTP_PROXY: '',
+    HTTPS_PROXY: '',
+    ALL_PROXY: '',
+    http_proxy: '',
+    https_proxy: '',
+    all_proxy: '',
+    NO_PROXY: '*',
+    no_proxy: '*',
+  };
+}
+
+function createBuildPlan(mode, root = repositoryRoot, nextArgs = []) {
+  if (!modes.has(mode)) throw new Error(`Unknown build mode: ${mode}`);
+  if (nextArgs.some((arg) => !['--webpack', '--debug'].includes(arg)))
+    throw new Error('Only --webpack and --debug are supported as extra Next build arguments');
+  if (nextArgs.length && !['all', 'next'].includes(mode))
+    throw new Error('Extra Next arguments require all or next mode');
+  const desktop = {
+    name: 'desktop',
+    args: [path.join(root, 'node_modules/vite/bin/vite.js'), 'build'],
+    env: {},
+  };
+  const mobile = {
+    name: 'mobile',
+    args: [path.join(root, 'node_modules/vite/bin/vite.js'), 'build'],
+    env: { MOBILE: 'true' },
+  };
+  // These scripts use only Node APIs. Node 24 strips their .mts type syntax;
+  // avoiding the tsx CLI also avoids its unnecessary Unix IPC socket server.
+  const copy = [
+    { name: 'copy-assets', args: [path.join(root, 'scripts/copySpaBuild.mts')], env: {} },
+    {
+      name: 'generate-templates',
+      args: [path.join(root, 'scripts/generateSpaTemplates.mts')],
+      env: {},
+    },
+  ];
+  const next = {
+    name: 'next',
+    args: [
+      path.join(root, 'node_modules/next/dist/bin/next'),
+      'build',
+      '--webpack',
+      ...nextArgs.filter((arg) => arg !== '--webpack'),
+    ],
+    env: {},
+  };
+  const plan = {
+    all: [desktop, mobile, ...copy, next],
+    desktop: [desktop],
+    mobile: [mobile],
+    copy,
+    next: [next],
+    analyze: [
+      {
+        name: 'analyze',
+        args: [path.join(root, 'node_modules/next/dist/bin/next'), 'experimental-analyze'],
+        env: {},
+      },
+    ],
+  }[mode];
+  return plan;
+}
+
+async function runBuild(
+  mode = 'all',
+  { root = repositoryRoot, env = process.env, nextArgs = [] } = {},
+) {
+  if (Number(process.versions.node.split('.')[0]) < 24)
+    throw new Error('The intranet build requires Node.js 24 or newer');
+  const plan = createBuildPlan(mode, root, nextArgs);
+  createBuildEnv(env); // Validate before deleting previous generated artifacts.
+  for (const step of plan) {
+    if (!existsSync(step.args[0]))
+      throw new Error(
+        `Missing build prerequisite: ${step.args[0]}. Install the locked dependencies during preparation.`,
+      );
+  }
+  if (['all', 'desktop'].includes(mode))
+    rmSync(path.join(root, 'public/_spa'), { recursive: true, force: true });
+  let child;
+  const onInterrupt = () => child?.kill('SIGINT');
+  const onTerminate = () => child?.kill('SIGTERM');
+  process.on('SIGINT', onInterrupt);
+  process.on('SIGTERM', onTerminate);
+  try {
+    for (const step of plan) {
+      if (step.name === 'next') {
+        const output = path.join(root, '.next');
+        if (existsSync(output)) {
+          // Remove stale generated output with retries before Next's parallel
+          // cleanup. Retain its cache so repeated offline builds can reuse it.
+          for (const entry of readdirSync(output)) {
+            if (entry === 'cache') continue;
+            rmSync(path.join(output, entry), {
+              recursive: true,
+              force: true,
+              maxRetries: 10,
+              retryDelay: 200,
+            });
+          }
+        }
+      }
+      console.log(
+        `[intranet-build] ${step.name}; network endpoints: none; heap: ${env.LOBE_BUILD_HEAP_MB || '4400'} MiB`,
+      );
+      await new Promise((resolve, reject) => {
+        child = spawn(process.execPath, step.args, {
+          cwd: root,
+          env: createBuildEnv(env, step.env),
+          stdio: 'inherit',
+        });
+        child.once('error', reject);
+        child.once('exit', (code, signal) =>
+          code === 0 ? resolve() : reject(new Error(`${step.name} failed (${signal || code})`)),
+        );
+      });
+    }
+  } finally {
+    process.removeListener('SIGINT', onInterrupt);
+    process.removeListener('SIGTERM', onTerminate);
+  }
+}
+
+module.exports = { createBuildEnv, createBuildPlan, runBuild };
+if (require.main === module) {
+  runBuild(process.argv[2] || 'all', { nextArgs: process.argv.slice(3) }).catch((error) => {
+    console.error(`[intranet-build] ${error.message}`);
+    process.exitCode = 1;
+  });
+}
diff --git a/scripts/intranet/build.test.cjs b/scripts/intranet/build.test.cjs
new file mode 100644
index 0000000000..6ca4fa4b03
--- /dev/null
+++ b/scripts/intranet/build.test.cjs
@@ -0,0 +1,255 @@
+'use strict';
+
+const assert = require('node:assert/strict');
+const { execFileSync } = require('node:child_process');
+const {
+  existsSync,
+  mkdirSync,
+  mkdtempSync,
+  readFileSync,
+  rmSync,
+  writeFileSync,
+} = require('node:fs');
+const { tmpdir } = require('node:os');
+const { dirname, join } = require('node:path');
+const test = require('node:test');
+const { createBuildEnv, createBuildPlan, runBuild } = require('./build.cjs');
+
+test('build environment discards runtime endpoints, proxy settings and NODE_OPTIONS overrides', () => {
+  const env = createBuildEnv({
+    NODE_OPTIONS: '--require=/untrusted/hook.js',
+    HTTP_PROXY: 'http://proxy:8080',
+    HTTPS_PROXY: 'http://proxy:8080',
+    ALL_PROXY: 'socks5://proxy:1080',
+    http_proxy: 'proxy',
+    https_proxy: 'proxy',
+    all_proxy: 'proxy',
+    LOBE_INTRANET_ALLOWED_ENDPOINTS: 'internal:1234',
+    RAYON_NUM_THREADS: '999',
+    MOBILE: 'true',
+  });
+  for (const name of [
+    'HTTP_PROXY',
+    'HTTPS_PROXY',
+    'ALL_PROXY',
+    'http_proxy',
+    'https_proxy',
+    'all_proxy',
+    'LOBE_INTRANET_ALLOWED_ENDPOINTS',
+  ])
+    assert.equal(env[name], '');
+  assert(!env.NODE_OPTIONS.includes('untrusted'));
+  assert(env.NODE_OPTIONS.includes('--max-old-space-size=4400'));
+  assert(env.NODE_OPTIONS.includes('network-guard.cjs'));
+  assert.equal(env.RAYON_NUM_THREADS, '2');
+  assert.equal(env.UV_THREADPOOL_SIZE, '2');
+  assert.equal(env.MOBILE, 'false');
+  assert.equal(env.NEXT_TELEMETRY_DISABLED, '1');
+  assert.equal(createBuildEnv({}, { MOBILE: 'true' }).MOBILE, 'true');
+});
+
+test('memory settings and build modes fail closed on invalid input', () => {
+  for (const value of ['0', '-1', '9999999', '4400 --require=x', '1.5'])
+    assert.throws(() => createBuildEnv({ LOBE_BUILD_HEAP_MB: value }), /must be an integer/);
+  assert(createBuildEnv({ LOBE_BUILD_HEAP_MB: '4096' }).NODE_OPTIONS.includes('4096'));
+  assert.throws(() => createBuildPlan('unknown'), /Unknown build mode/);
+  assert.throws(
+    () => createBuildPlan('next', '/tmp', ['--experimental-build-mode=compile']),
+    /Only/,
+  );
+  assert.deepEqual(createBuildPlan('next', '/tmp', ['--webpack'])[0].args.slice(-2), [
+    'build',
+    '--webpack',
+  ]);
+  assert.deepEqual(createBuildPlan('next', '/tmp')[0].args.slice(-2), ['build', '--webpack']);
+  const finalStep = createBuildPlan('all', '/tmp').at(-1);
+  assert.deepEqual(finalStep.args.slice(-2), ['build', '--webpack']);
+  const repeated = createBuildPlan('next', '/tmp', ['--webpack', '--debug', '--webpack'])[0].args;
+  assert.equal(repeated.filter((argument) => argument === '--webpack').length, 1);
+  assert.deepEqual(repeated.slice(-3), ['build', '--webpack', '--debug']);
+});
+
+test('real Node subprocess preloads guard and blocks public requests without DNS or network', () => {
+  const output = execFileSync(
+    process.execPath,
+    [
+      '-e',
+      `
+    const assert=require('node:assert/strict');
+    assert(globalThis[Symbol.for('lobehub.intranet.guard')]);
+    fetch('https://build-probe.example.com').then(()=>process.exit(2),error=>{
+      assert.equal(error.code,'LOBE_INTRANET_EGRESS_DENIED');
+      console.log('guard-active-and-public-request-denied');
+    });
+  `,
+    ],
+    { env: createBuildEnv(process.env), encoding: 'utf8' },
+  );
+  assert.equal(output.trim(), 'guard-active-and-public-request-denied');
+});
+
+test('the installed Next worker preserves the guard after rewriting NODE_OPTIONS', () => {
+  const dir = mkdtempSync(join(tmpdir(), 'lobe-next-worker-'));
+  try {
+    const worker = join(dir, 'worker.cjs');
+    writeFileSync(
+      worker,
+      `exports.probe=async()=>{try{await fetch('https://next-worker-probe.example.com');return {denied:false};}catch(error){return {guard:!!globalThis[Symbol.for('lobehub.intranet.guard')],code:error.code};}};`,
+    );
+    const nextWorker = require.resolve('next/dist/lib/worker');
+    const parent = join(dir, 'parent.cjs');
+    writeFileSync(
+      parent,
+      `
+      const {Worker}=require(${JSON.stringify(nextWorker)});
+      (async()=>{
+        const worker=new Worker(${JSON.stringify(worker)},{numWorkers:1,exposedMethods:['probe'],enableWorkerThreads:false});
+        try{console.log(JSON.stringify(await worker.probe()));}finally{await worker.end();}
+      })().catch(error=>{console.error(error.message);process.exitCode=1;});
+    `,
+    );
