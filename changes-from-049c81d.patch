+'use strict';
+
+const assert = require('node:assert/strict');
+const { randomUUID } = require('node:crypto');
+const { Pool } = require('pg');
+const { S3Client, GetObjectCommand, DeleteObjectCommand } = require('@aws-sdk/client-s3');
+const { getSignedUrl } = require('@aws-sdk/s3-request-presigner');
+
+(async () => {
+  const origin = process.env.APP_URL;
+  const email = process.env.INTRANET_TEST_EMAIL;
+  const password = process.env.INTRANET_TEST_PASSWORD;
+  assert(
+    email && password?.length >= 16,
+    'INTRANET_TEST_EMAIL and a 16+ character INTRANET_TEST_PASSWORD are required',
+  );
+  const request = (path, init = {}) =>
+    fetch(`${origin}${path}`, {
+      ...init,
+      signal: AbortSignal.timeout(120_000),
+      headers: { 'Origin': origin, 'Content-Type': 'application/json', ...init.headers },
+    });
+  let cookie;
+  let created = false;
+  let createdId;
+  const key = `acceptance/${randomUUID()}.txt`;
+  const s3 = new S3Client({
+    endpoint: origin,
+    region: 'us-east-1',
+    forcePathStyle: true,
+    credentials: {
+      accessKeyId: process.env.S3_ACCESS_KEY_ID,
+      secretAccessKey: process.env.S3_SECRET_ACCESS_KEY,
+    },
+    requestChecksumCalculation: 'WHEN_REQUIRED',
+  });
+  try {
+    const signup = await request('/api/auth/sign-up/email', {
+      method: 'POST',
+      body: JSON.stringify({ email, password, name: 'Isolated deployment acceptance' }),
+    });
+    assert(signup.ok, `Use a NEW allowed test account; signup HTTP ${signup.status}`);
+    created = true;
+    createdId = (await signup.json()).user?.id;
+    assert(createdId, 'Signup did not return the new user identity');
+    const signupCookie = signup.headers
+      .getSetCookie()
+      .map((value) => value.split(';')[0])
+      .join('; ');
+    if (signupCookie)
+      await request('/api/auth/sign-out', {
+        method: 'POST',
+        headers: { Cookie: signupCookie },
+        body: '{}',
+      });
+    const signin = await request('/api/auth/sign-in/email', {
+      method: 'POST',
+      body: JSON.stringify({ email, password }),
+    });
+    assert(signin.ok, `Password sign-in HTTP ${signin.status}`);
+    cookie = signin.headers
+      .getSetCookie()
+      .map((value) => value.split(';')[0])
+      .join('; ');
+    assert(cookie, 'No authentication cookie');
+    const session = await request('/api/auth/get-session', { headers: { Cookie: cookie } });
+    assert.equal((await session.json()).user?.email, email);
+    const appChat = await request('/webapi/chat/ollama', {
+      method: 'POST',
+      headers: { Cookie: cookie },
+      body: JSON.stringify({
+        model: 'qwen3:8b',
+        messages: [{ role: 'user', content: 'Reply with OK. /no_think' }],
+        stream: true,
+        max_tokens: 32,
+        temperature: 0,
+      }),
+    });
+    assert(appChat.ok, `Authenticated application chat HTTP ${appChat.status}`);
+    const chatStream = await appChat.text();
+    const textEvents = chatStream
+      .split(/\r?\n\r?\n/)
+      .filter((event) => /^event: text$/m.test(event))
+      .map((event) =>
+        event
+          .split(/\r?\n/)
+          .filter((line) => line.startsWith('data:'))
+          .map((line) => line.slice(5).trim())
+          .join('\n'),
+      )
+      .filter(Boolean);
+    assert(
+      textEvents.some((data) => {
+        try {
+          return typeof JSON.parse(data) === 'string' && JSON.parse(data).trim().length > 0;
+        } catch {
+          return false;
+        }
+      }) && !chatStream.includes('event: error'),
+      'Application chat stream did not contain generated text',
+    );
+
+    const page = await request('/');
+    assert(page.ok, `Application page HTTP ${page.status}`);
+    const csp = page.headers.get('content-security-policy') || '';
+    assert(
+      csp.includes("connect-src 'self'") && csp.includes("default-src 'none'"),
+      'Missing strict page CSP',
+    );
+    const upload = await request('/trpc/lambda/upload.createS3PreSignedUrl', {
+      method: 'POST',
+      headers: { Cookie: cookie },
+      body: JSON.stringify({ json: { pathname: key } }),
+    });
+    assert(upload.ok, `Authenticated upload API HTTP ${upload.status}`);
+    const result = await upload.json();
+    const signedPut = result.result?.data?.json;
+    assert.equal(new URL(signedPut).origin, origin, 'Upload must stay same-origin');
+    const put = await fetch(signedPut, {
+      method: 'PUT',
+      body: 'intranet upload verified',
+      headers: { 'Content-Type': 'text/plain' },
+      signal: AbortSignal.timeout(15_000),
+    });
+    assert(put.ok, `Signed S3 PUT HTTP ${put.status}`);
+    const signedGet = await getSignedUrl(
+      s3,
+      new GetObjectCommand({ Bucket: 'lobehub-files', Key: key }),
+      { expiresIn: 60 },
+    );
+    const get = await fetch(signedGet, { signal: AbortSignal.timeout(15_000) });
+    assert.equal(await get.text(), 'intranet upload verified');
+    assert(
+      (get.headers.get('content-security-policy') || '').includes('sandbox'),
+      'Uploaded content lacks sandbox CSP',
+    );
+    assert.equal(get.headers.get('content-disposition'), 'attachment');
+
+    const tagsResponse = await fetch(`${process.env.OLLAMA_PROXY_URL}/api/tags`, {
+      signal: AbortSignal.timeout(15_000),
+    });
+    assert(tagsResponse.ok, 'Ollama tags failed');
+    const tags = await tagsResponse.json();
+    for (const model of ['qwen3:8b', 'bge-m3'])
+      assert(
+        tags.models?.some((item) => item.name === model || item.name === `${model}:latest`),
+        `Missing preloaded model ${model}`,
+      );
+    const chat = await fetch(`${process.env.OLLAMA_PROXY_URL}/api/chat`, {
+      method: 'POST',
+      body: JSON.stringify({
+        model: 'qwen3:8b',
+        messages: [{ role: 'user', content: 'Reply with OK. /no_think' }],
+        stream: false,
+        options: { num_predict: 64 },
+      }),
+      signal: AbortSignal.timeout(120_000),
+    });
+    assert(
+      chat.ok && (await chat.json()).message?.content?.length,
+      'Local model failed to generate text',
+    );
+    const embedding = await fetch(`${process.env.OLLAMA_PROXY_URL}/api/embed`, {
+      method: 'POST',
+      body: JSON.stringify({ model: 'bge-m3', input: 'Internal knowledge base acceptance' }),
+      signal: AbortSignal.timeout(120_000),
+    });
+    assert.equal(
+      (await embedding.json()).embeddings?.[0]?.length,
+      1024,
+      'Knowledge embedding must match the database vector dimension',
+    );
+    const database = new Pool({ connectionString: process.env.DATABASE_URL });
+    try {
+      const extensions = await database.query(
+        "SELECT extname FROM pg_extension WHERE extname IN ('vector','pg_search')",
+      );
+      assert.equal(extensions.rowCount, 2, 'Both vector and pg_search are mandatory');
+      const migrations = await database.query(
+        'SELECT count(*)::int AS count FROM drizzle.__drizzle_migrations',
+      );
+      assert(migrations.rows[0].count > 0, 'No applied migrations');
+    } finally {
+      await database.end();
+    }
+    console.log(
+      JSON.stringify({
+        signup: 'passed',
+        passwordSignin: 'passed',
+        session: 'passed',
+        applicationChatStream: 'passed',
+        signedStorage: 'passed',
+        pageCsp: 'passed',
+        uploadedContentSandbox: 'passed',
+        modelChat: 'passed',
+        embeddingDimensions: 1024,
+        migrations: 'passed',
+      }),
+    );
+  } finally {
+    await s3.send(new DeleteObjectCommand({ Bucket: 'lobehub-files', Key: key }));
+    s3.destroy();
+    if (created) {
+      if (!cookie) {
+        const signin = await request('/api/auth/sign-in/email', {
+          method: 'POST',
+          body: JSON.stringify({ email, password }),
+        });
+        cookie = signin.headers
+          .getSetCookie()
+          .map((value) => value.split(';')[0])
+          .join('; ');
+      }
+      await request('/api/auth/sign-out', {
+        method: 'POST',
+        headers: { Cookie: cookie },
+        body: '{}',
+      });
+      const cleanup = new Pool({ connectionString: process.env.DATABASE_URL });
+      try {
+        // Better Auth deleteUser is disabled upstream. Delete only the exact
+        // account this probe just created, using bound SQL parameters.
+        assert(createdId, 'Cannot safely clean up an unknown test user');
+        const deleted = await cleanup.query('DELETE FROM users WHERE id=$1 AND email=$2', [
+          createdId,
+          email,
+        ]);
+        assert.equal(
+          deleted.rowCount,
+          1,
+          'Test user cleanup failed; inspect before retrying acceptance',
+        );
+      } finally {
+        await cleanup.end();
+      }
+    }
+  }
+})().catch((error) => {
+  console.error(`Application acceptance failed: ${error.message}`);
+  process.exitCode = 1;
+});
diff --git a/deploy/intranet/probe-network.cjs b/deploy/intranet/probe-network.cjs
new file mode 100644
index 0000000000..76218f8a6e
--- /dev/null
+++ b/deploy/intranet/probe-network.cjs
@@ -0,0 +1,65 @@
+'use strict';
+
+// Intentionally run WITHOUT the preload. This tests the container's kernel
+// boundary that also contains native code and child processes.
+const assert = require('node:assert/strict');
+const net = require('node:net');
+const { Resolver } = require('node:dns').promises;
+const dgram = require('node:dgram');
+
+function connect(host, port) {
+  return new Promise((resolve, reject) => {
+    const socket = net.createConnection({ host, port });
+    socket.once('connect', () => {
+      socket.destroy();
+      resolve();
+    });
+    socket.once('error', reject);
+    socket.setTimeout(4000, () => socket.destroy(new Error('Probe timeout')));
+  });
+}
+
+(async () => {
+  await connect('172.30.90.11', 6379);
+  for (const host of ['1.1.1.1', '2606:4700:4700::1111', '169.254.169.254']) {
+    await assert.rejects(connect(host, 443), `Unexpected connection to ${host}`);
+  }
+  const local = new Resolver({ timeout: 1000, tries: 1 });
+  local.setServers(['172.30.90.53']);
+  await assert.rejects(
+    local.resolve4(`egress-probe-${Date.now()}.example.com`),
+    (error) => error.code === 'ENOTFOUND',
+  );
+  const external = new Resolver({ timeout: 1000, tries: 1 });
+  external.setServers(['1.1.1.1']);
+  await assert.rejects(external.resolve4(`egress-probe-${Date.now()}.example.com`));
+  await new Promise((resolve) => {
+    const udp = dgram.createSocket('udp4');
+    let finished = false;
+    const done = () => {
+      if (!finished) {
+        finished = true;
+        clearTimeout(timer);
+        udp.close();
+        resolve();
+      }
+    };
+    const timer = setTimeout(done, 1000);
+    udp.on('error', done);
+    udp.connect(443, '1.1.1.1', () => udp.send(Buffer.alloc(0), () => {}));
+  });
+  // UDP send alone has no delivery acknowledgement: packet capture and kernel
+  // counters in accept.mjs supply the evidence that the datagram was blocked.
+  console.log(
+    JSON.stringify({
+      kernelTcpEgress: 'denied',
+      internalRedis: 'reachable',
+      externalDns: 'denied',
+      authoritativeDns: 'NXDOMAIN',
+      udp443: 'probed; require zero-packet capture',
+    }),
+  );
+})().catch((error) => {
+  console.error(error.message);
+  process.exitCode = 1;
+});
