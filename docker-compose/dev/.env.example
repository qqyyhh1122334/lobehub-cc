# Infrastructure on the intranet server; run Vite and Next.js on the development machine.
# Copy this file to .env in this directory, then run here:
# docker compose up -d --wait postgresql redis rustfs searxng
# docker compose run --rm --no-deps rustfs-init
# Run bucket initialization separately after the infrastructure is ready.
# No application container starts without the optional server profile.

# Published host interface and ports. Use the server's private/VPN IP to restrict binding.
# 0.0.0.0 preserves the existing default of listening on all interfaces.
DEV_BIND_HOST=0.0.0.0
POSTGRES_PORT=5432
REDIS_PORT=6379
RUSTFS_PORT=9000
RUSTFS_ADMIN_PORT=9001
SEARXNG_PORT=8180

# PostgreSQL
LOBE_DB_NAME=lobechat
POSTGRES_PASSWORD=change_this_password_on_production

# RustFS S3 credentials and bucket
RUSTFS_ACCESS_KEY=admin
RUSTFS_SECRET_KEY=change_this_password_on_production
RUSTFS_LOBE_BUCKET=lobe
# Browser uploads originate from the local Next.js page, not the Vite module server.
# Comma-separated origins; include the exact host/port used in your browser.
# Example override: http://localhost:3010,http://127.0.0.1:3010
RUSTFS_CORS_ALLOWED_ORIGINS=http://localhost:3010
# This endpoint is only consumed by the optional application container below.
# For remote infrastructure, also configure the development machine's Next.js env
# with an S3_ENDPOINT reachable by both local Next.js and the browser.
# Example: http://10.0.0.8:9000 or https://files-dev.example.com, not a Docker service name.
S3_ENDPOINT=http://localhost:9000

# Optional alternative: run the Next.js backend on this server in Node 22.
# docker compose --profile server up -d --wait
# docker compose --profile server logs -f lobe
# The container installs dependencies, migrates the database and runs Next dev only.
# First install needs registry access and may take several minutes; follow logs.
NODE_IMAGE=node:22-bookworm-slim
LOBE_PORT=3210
# Browser-facing backend URL, including HTTPS when TLS terminates at a gateway.
APP_URL=http://localhost:3210
# Required only for the server profile. Generate each separately and keep them stable:
# openssl rand -base64 32
AUTH_SECRET=
KEY_VAULTS_SECRET=
# Use a dedicated server checkout; pnpm also writes workspace node_modules links.
# Root .env.development* files can override container settings during migration.
# Set RustFS CORS above to this backend's APP_URL when using its Debug Proxy page.
# Optional model settings for this application container belong here;
# for the default local Next.js workflow, configure them on the development machine instead.
# OPENAI_API_KEY=sk-xxxx
# OPENAI_PROXY_URL=https://api.openai.com/v1
