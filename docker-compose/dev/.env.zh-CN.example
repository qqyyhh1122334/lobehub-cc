# 内网服务器仅运行基础设施，开发机运行 Vite 和 Next.js。
# 将本文件复制为同目录 .env，然后在本目录执行：
# docker compose up -d --wait postgresql redis rustfs searxng
# docker compose run --rm --no-deps rustfs-init
# 先等待基础设施就绪，再单独执行 bucket 初始化。
# 不启用可选 server profile 时，不会启动应用容器。

# 发布服务的宿主接口和端口；可填写服务器私网或 VPN IP 限制监听地址。
# 0.0.0.0 保留原有监听所有接口的默认行为。
DEV_BIND_HOST=0.0.0.0
POSTGRES_PORT=5432
REDIS_PORT=6379
RUSTFS_PORT=9000
RUSTFS_ADMIN_PORT=9001
SEARXNG_PORT=8180

# PostgreSQL
LOBE_DB_NAME=lobechat
POSTGRES_PASSWORD=change_this_password_on_production

# RustFS S3 访问凭据和 bucket
RUSTFS_ACCESS_KEY=admin
RUSTFS_SECRET_KEY=change_this_password_on_production
RUSTFS_LOBE_BUCKET=lobe
# 浏览器上传的 Origin 来自本地 Next.js 页面，而不是 Vite 模块服务器。
# 支持逗号分隔；必须包含浏览器实际使用的主机和端口。
# 覆盖示例：http://localhost:3010,http://127.0.0.1:3010
RUSTFS_CORS_ALLOWED_ORIGINS=http://localhost:3010
# 此地址仅由下方可选应用容器读取。
# 使用远程基础设施时，还需在开发机 Next.js 的环境配置中设置 S3_ENDPOINT，
# 使本地 Next.js 和浏览器均可访问。
# 示例：http://10.0.0.8:9000 或 https://files-dev.example.com，不要填写 Docker 服务名。
S3_ENDPOINT=http://localhost:9000

# 可选替代：在服务器的 Node 22 容器中运行 Next.js 后端。
# docker compose --profile server up -d --wait
# docker compose --profile server logs -f lobe
# 容器依次安装依赖、迁移数据库，再仅启动 Next dev。
# 首次安装需访问依赖仓库，可能耗时数分钟，请通过 logs 查看进度。
NODE_IMAGE=node:22-bookworm-slim
LOBE_PORT=3210
# 浏览器访问后端的地址；网关终止 TLS 时填写对应 HTTPS 地址。
APP_URL=http://localhost:3210
# 仅 server profile 必填；分别运行以下命令生成，并持久保存：
# openssl rand -base64 32
AUTH_SECRET=
KEY_VAULTS_SECRET=
# 服务器使用独立 checkout；pnpm 也会写入各 workspace 的 node_modules 链接。
# 根目录 .env.development* 文件可能覆盖迁移时的容器配置。
# 使用此后端的 Debug Proxy 页面时，将上方 RustFS CORS 改为其 APP_URL。
# 此应用容器的可选模型配置可放在这里；
# 默认的本地 Next.js 开发方式应改为在开发机配置这些变量。
# OPENAI_API_KEY=sk-xxxx
# OPENAI_PROXY_URL=https://api.openai.com/v1
