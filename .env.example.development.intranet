# 本地 Next.js + Vite，连接内网服务器上的 Docker 基础服务。
# 复制为根目录 .env.development.local，填写主机和凭据后运行 bun run dev。
# 浏览器打开 http://localhost:3010；本地 Next.js 为页面、鉴权和 API 提供服务。
# 本模板使用 ${变量} 引用，由开发启动器的 dotenv-expand 展开，不要直接 source。

# 内网基础服务主机：填写实际 IPv4 地址，不带协议、端口或路径。
# 各服务在同一台服务器时，只需修改此处即可更新下面的连接地址。
DEV_INFRA_HOST=
DEV_POSTGRES_PORT=5432
DEV_REDIS_PORT=6379
DEV_RUSTFS_PORT=9000
DEV_SEARXNG_PORT=8180

# 本地应用。保持前后端在本机运行，不启用仅本地 SPA + 远程后端模式。
# bun run dev 会将子进程的 DEV_BACKEND_URL 指向本地 Next.js，此处留空即可。
# 单独运行 dev:spa 时仍按原方式选择后端，不会仅凭此模板自动启动本地 Next.js。
PORT=3010
APP_URL=http://localhost:${PORT}
INTERNAL_APP_URL=http://localhost:${PORT}
DEV_BACKEND_URL=

# 认证密钥：运行 openssl rand -base64 32 单独生成，填写并稳定保存。
AUTH_SECRET=
# 新建数据库时另运行 openssl rand -base64 32 生成此密钥。
# 连接已有数据库时必须复用该库原有 KEY_VAULTS_SECRET，以解密已保存的凭据。
KEY_VAULTS_SECRET=

# PostgreSQL：与服务器 docker-compose/dev/.env 中的数据库名称、密码对应。
# 使用专用开发数据库；数据库迁移也会通过此连接执行。
LOBE_DB_NAME=lobechat
POSTGRES_PASSWORD=
DATABASE_DRIVER=node
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@${DEV_INFRA_HOST}:${DEV_POSTGRES_PORT}/${LOBE_DB_NAME}
# 密码包含 @、:、/、#、% 等 URL 特殊字符时，须在客户端连接 URL 中做百分号编码；
# 可以直接改写上面的 DATABASE_URL，服务器 POSTGRES_PASSWORD 保留原始密码。

# Redis：对应默认开发 Compose 的无密码连接；服务端启用认证/TLS 时改写此 URL。
REDIS_URL=redis://${DEV_INFRA_HOST}:${DEV_REDIS_PORT}
REDIS_PREFIX=lobechat-local-dev
REDIS_TLS=0

# RustFS：填写服务器的访问密钥、秘密密钥和 bucket 名称。
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_LOBE_BUCKET=lobe
S3_ACCESS_KEY_ID=${RUSTFS_ACCESS_KEY}
S3_SECRET_ACCESS_KEY=${RUSTFS_SECRET_KEY}
S3_BUCKET=${RUSTFS_LOBE_BUCKET}
S3_ENDPOINT=http://${DEV_INFRA_HOST}:${DEV_RUSTFS_PORT}
S3_ENABLE_PATH_STYLE=1
S3_SET_ACL=0
# S3_ENDPOINT 必须同时被本地 Next.js 和浏览器访问，不能用 Docker 容器名。
# 在服务器 RustFS 中设置 RUSTFS_CORS_ALLOWED_ORIGINS=http://localhost:3010，
# 并验证 PUT 预检。若页面换为 HTTPS，S3_ENDPOINT 也需使用可达的 HTTPS 域名。
# S3_PUBLIC_DOMAIN 不改变直传签名地址；S3_SET_ACL=0 不会移除已有匿名读策略。

# 本地后端读取图片转 base64，减少外部模型直接抓取内网附件地址的需求。
# 这不替代浏览器直传/CORS，也不保证覆盖所有模型、生图或外部沙箱功能。
LLM_VISION_IMAGE_USE_BASE64=1

# 允许受 SSRF 防护的读取访问本机和指定基础服务主机，保持其他私网地址受限。
# DEV_INFRA_HOST 使用 IPv4，便于此 IP 白名单与连接地址同步。
SSRF_ALLOW_PRIVATE_IP_ADDRESS=0
SSRF_ALLOW_IP_ADDRESS_LIST=${DEV_INFRA_HOST},127.0.0.1,::1

# 搜索服务：服务器默认将 SearXNG 8080 发布到宿主机 8180。
SEARXNG_URL=http://${DEV_INFRA_HOST}:${DEV_SEARXNG_PORT}

# 模型服务按实际 provider 配置；内网模型地址由本地后端访问。
# OPENAI_API_KEY=
# OPENAI_PROXY_URL=http://<模型服务主机>:<端口>/v1
# ANTHROPIC_API_KEY=
# ANTHROPIC_PROXY_URL=https://api.anthropic.com
